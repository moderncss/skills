---
import { Code } from "astro:components";
import InfoPopover from "../info-popover/info-popover.astro";

const before = `.card {
  color: #f5f5f5;
  width: 600px;
  padding: 16px 0;
}
@media (max-width: 768px) {
  .card {
    padding: 12px 0;
  }
}
.card:hover {
  background-color: #e0e0e0;
}`;

const withRulesCode = `@layer components {
  @scope (.card) to (.slot) {
    :scope {
      color: light-dark(oklch(96% 0 0deg), oklch(25% 0 0deg));
      container-type: inline-size;
      padding-block: clamp(1rem, 2cqi, 2rem);

      &:hover {
        background-color: oklch(from currentcolor l c h / 10%);
      }
    }
  }
}`;

const prompts = `Set up the base styles and design tokens for this new project.

Refactor my styles to modern CSS, staying within Baseline Widely Available.

Build a pricing table for the plans page and make it responsive.`;
---

<section class="get-started">
  <h2>Get started</h2>
  <div>
    <form>
      <label for="skill-command">
        Install the <a href="/skill">skill</a>:
      </label>
      <copy-clipboard>
        <input
          id="skill-command"
          type="text"
          value="npx skills add moderncss/skills"
          readonly
        />
      </copy-clipboard>
      <label for="config-command">
        And the <a href="https://www.npmx.dev/package/stylelint-config-modern"
          >Stylelint config</a
        >:
      </label>
      <copy-clipboard>
        <input
          id="config-command"
          type="text"
          value="npm i -D stylelint-config-modern"
          readonly
        />
      </copy-clipboard>
      <label for="example-prompt">Then prompt your agent:</label>
      <prompt-cycler>
        <copy-clipboard>
          <textarea id="example-prompt" readonly>{prompts}</textarea>
        </copy-clipboard>
      </prompt-cycler>
    </form>
    <div>
      <code-comparison>
        <div slot="before">
          <Code
            code={before}
            lang="css"
            themes={{ light: "one-light", dark: "min-dark" }}
            defaultColor="light-dark()"
          />
        </div>
        <div slot="after">
          <Code
            code={withRulesCode}
            lang="css"
            themes={{ light: "one-light", dark: "min-dark" }}
            defaultColor="light-dark()"
          />
        </div>
      </code-comparison>
      <InfoPopover id="info-code" label="About this comparison">
        <p>
          <a href="/skill#organizing-styles-layer">Layers</a>, <a
            href="/skill#encapsulating-styles-scope">scope</a
          >, <a href="/skill#nesting-rules-and-at-rules-">nesting</a>, <a
            href="/skill#relative-color-functions-oklchfrom-----color-mix-"
            >relative colors</a
          >, and
          <a href="/skill#fluid-spacing-cqi">container units</a> afterwards.
        </p>
      </InfoPopover>
      <p>
        <small> Before & after with Claude Opus 5.5.</small>
      </p>
    </div>
  </div>
</section>
